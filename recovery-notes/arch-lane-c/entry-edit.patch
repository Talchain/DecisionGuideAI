+
+/**
+ * The real path: core's answer → `readView` (client.ts) → the View store the canvas draws from. An invalid View is never installed:
+ * a board already drawn stays as it was with the error said; with nothing drawn yet, the page shows the error and no board.
+ */
+describe('on the real path, an invalid View is never installed', () => {
+  const SID = 's_0123456789ab', UUID = '00000000-0000-4000-8000-0123456789ab'
+  const serve = (body: unknown) => setTeamFetch((async () => new Response(JSON.stringify(body), { status: 200 })) as unknown as typeof fetch)
+  const broken = () => { const x = golden('pricing'); x.model.cards[1].label = 42; return x }
+  afterEach(() => { setTeamFetch(null); useViewStore.setState({ uuid: null, sid: null, view: null, opened: { open: new Map(), all: false }, status: 'none', error: null, stale: false, at: null }) })
+
+  it('readView refuses a View with a nested fault in plain words, and returns a valid one untouched', async () => {
+    serve(broken())
+    await expect(readView(SID)).rejects.toEqual(new TeamApiError(0, VIEW_SHAPE_CHANGED))
+    serve(golden('pricing'))
+    expect(await readView(SID)).toEqual(golden('pricing'))
+  })
+
+  it('a past version is read as that version; a core answering another version is still said, never drawn', async () => {
+    serve(golden('s_ce285b3617bb'))
+    expect((await readView(SID, undefined, 2)).version?.n).toBe(2)
+    await expect(readView(SID, undefined, 1)).rejects.toEqual(new TeamApiError(0, VERSION_NOT_SERVED))
+  })
+
+  it('nothing drawn yet: an invalid View leaves no board and says why', async () => {
+    serve(broken())
+    await useViewStore.getState().use(UUID)
+    expect(useViewStore.getState()).toMatchObject({ view: null, status: 'error', error: VIEW_SHAPE_CHANGED })
+  })
+
+  it('a board already drawn: an invalid re-read keeps that board exactly, and says why', async () => {
+    serve(golden('pricing'))
+    await useViewStore.getState().use(UUID)
+    const drawn = useViewStore.getState().view
+    expect(drawn?.title).toBe(golden('pricing').title)
+    serve(broken())
+    expect(await useViewStore.getState().refresh()).toBe(false)
+    expect(useViewStore.getState()).toMatchObject({ status: 'ready', error: VIEW_SHAPE_CHANGED })
+    expect(useViewStore.getState().view).toBe(drawn)
+  })
+})
