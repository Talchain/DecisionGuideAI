        "bias_category": "narrow_framing"
      },
      {
        "id": "quantify-annual-cost",
        "label": "Attach £120k ceiling to the budget factor",
        "detail": "Annual Platform Cost has no numeric anchor in the graph, making Annual Budget Overrun Risk unverifiable — assign the £120k threshold explicitly so each option can be tested against a concrete pass/fail.",
        "action_type": "quantify",
        "bias_category": "overconfidence"
      },
      {
        "id": "link-ops-overhead-setup-time",
        "label": "Connect operational overhead to setup time",
        "detail": "Higher ongoing operational overhead (e.g. self-hosted RudderStack or the Snowflake build) also lengthens initial migration and setup, so an edge from Operational Overhead on Data Team to Migration and Setup Time would capture this compounding effect on Migration Delay Before March Deadline.",
        "action_type": "add_edge"
      }
    ],
