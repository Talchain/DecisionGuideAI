      {
        "id": "link-team-capacity-setup-time",
        "label": "Connect team capacity to migration delay risk",
        "detail": "A two-person team is itself a direct driver of setup time and therefore migration delay, but Data Team Capacity currently only flows to Data Team Capacity Strain — add an edge from Data Team Capacity to Migration and Setup Time to capture this dependency.",
        "action_type": "add_edge",
        "bias_category": "availability"
      },
      {
        "id": "clarify-gdpr-knockout",
        "label": "Clarify EU residency as a hard constraint, not a scored factor",
        "detail": "EU Data Residency Compliance is modelled symmetrically across all options, but the brief states it is eliminatory — make explicit that any option failing this factor is disqualified before scoring on cost or capability, so the goal node reflects a binary gate rather than a trade-off.",
