# Development Environment Configuration
# This file is for local development only

# Enable copilot variant in development
VITE_COPILOT_ENABLED=true

# CEE routing: Use BFF proxy which routes through Netlify redirect to CEE service
# /bff/cee/* → https://olumi-assistants-service.onrender.com/assist/v1/*
VITE_CEE_BFF_BASE=/bff/cee
VITE_FEATURE_BIL=1

# Debug Bundle v2.0: CEE diagnostic trace capture (ON in dev/staging, OFF in production)
VITE_DEBUG_BUNDLE_V2=true

# Compare tab: Refinement Journey panel
VITE_FEATURE_COMPARE_TAB=true
