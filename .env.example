VITE_EDGE_GATEWAY_URL=http://localhost:3001
VITE_FEATURE_SSE=1

# PoC-only mode: renders only the Sandbox (no login/nav/landing)
# VITE_POC_ONLY=1
# VITE_AUTH_MODE=guest

# Sandbox features (ON by default in PoC mode)
# VITE_FEATURE_SCENARIO_SANDBOX=1
# VITE_FEATURE_SANDBOX_DECISION_CTA=1
# VITE_FEATURE_SANDBOX_MAPPING=1
# VITE_FEATURE_SANDBOX_PROJECTIONS=1
# VITE_FEATURE_SANDBOX_REALTIME=1
# VITE_FEATURE_SANDBOX_STRATEGY_BRIDGE=1
# VITE_FEATURE_SANDBOX_TRIGGERS_BASIC=1
# VITE_FEATURE_SANDBOX_VOTING=1
# VITE_FEATURE_WHITEBOARD=1

# Developer aids (OFF by default). Uncomment to enable:
# VITE_FEATURE_REPORT_COPY=1
# VITE_FEATURE_REPORT_DOWNLOAD=1
# VITE_FEATURE_REPORT_PRETTY=1
# VITE_FEATURE_REPLAY=1
# VITE_FEATURE_CANVAS=1
# VITE_FEATURE_SCENARIOS=1
# VITE_FEATURE_TLDRAW=1 # requires @tldraw/tldraw; app falls back to built-in canvas when missing
# VITE_EDGE_GATEWAY_URL=http://localhost:8787

# New feature flags (OFF by default unless otherwise noted)
# VITE_FEATURE_SUMMARY_V2=1
# VITE_FEATURE_GUIDED_V1=1
# VITE_FEATURE_COMMENTS=1
# VITE_FEATURE_DIAGNOSTICS=1
# VITE_FEATURE_PERF_PROBES=1
# VITE_FEATURE_SCORECARD=1

# Phase 1A.1: Verdict Card + Delta Interpretation (ON by default)
VITE_SHOW_VERDICT_CARD=true

# --- Feature flags (OFF by default). Each also reads localStorage['feature.<name>'] === '1' ---
# VITE_FEATURE_ERROR_BANNERS=0         # Concise error banners (taxonomy mapping), aria-live=polite
# VITE_FEATURE_CANVAS_DEFAULT=0        # Canvas-first split shell
# VITE_FEATURE_CANVAS_SIMPLIFY=0       # Simplify View (hide weak links)
# VITE_FEATURE_LIST_VIEW=0             # Read-only list mirror for accessibility/mobile
# VITE_FEATURE_ENGINE_ADAPTER=0        # Engine adapter / fixtures chip
# VITE_FEATURE_SNAPSHOTS=0             # Snapshots + read-only share
# VITE_FEATURE_COMPARE=0               # Side-by-side compare
# VITE_FEATURE_SCENARIO_IMPORT_PREVIEW=0 # Import preview bar for ?scenario= links
# VITE_FEATURE_COMPARE=0               # Side-by-side compare

# --- Production Monitoring (OFF in dev/test) ---
# VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id
# VITE_HOTJAR_ID=1234567
# VITE_RELEASE_VERSION=2.0.0  # Auto-set by Netlify build

# --- Logging Configuration ---
# Log level: 'debug' | 'info' | 'warn' | 'error'
# Default: 'warn' in production, 'debug' in development
# VITE_LOG_LEVEL=warn

# --- Debug Flags (ALL default to false - safe for demos) ---
# SECURITY: These flags are OFF by default, even in development.
# This prevents accidental exposure during demos, screen recordings,
# and shared dev environments.
# VITE_DEBUG_PAYLOADS=true  # Log API request/response payloads (NEVER in prod/demos)
# VITE_DEBUG_AUTH=true      # Log authentication events
# VITE_DEBUG_API=true       # Log API calls (URLs, headers)
# VITE_DEBUG_SUPABASE=true  # Log Supabase operations

# PLoT API (Phase A)
VITE_PLOT_API_BASE_URL=https://plot-api.example.com
VITE_UI_STREAM_CANARY=0

# --- Backend Service URLs (used by Vite dev proxy) ---
# CEE (Assistants) Service - Draft My Model, Framing Feedback, Insights
# NOTE: CEE calls now route through PLoT (see VITE_CEE_BFF_BASE below)
# Direct CEE URL kept for reference only
CEE_SERVICE_URL=https://olumi-assistants-service.onrender.com

# CEE Base URL - Where UI sends CEE requests
# Routes through PLoT which handles API key injection and has 120s timeout
# Staging: https://plot-lite-service-staging.onrender.com/v1/cee
# Production: https://plot-lite-service.onrender.com/v1/cee
# Local (if running PLoT locally): http://localhost:3001/v1/cee
# If not set, falls back to /bff/cee (deprecated Netlify Edge Function path)
VITE_CEE_BFF_BASE=https://plot-lite-service-staging.onrender.com/v1/cee

# CEE API Key - No longer needed in UI env vars
# PLoT handles API key injection server-side
# ASSIST_API_KEY=your_cee_api_key_here (deprecated - set in PLoT instead)

# ISL Service - Interactive Scenario Learning
ISL_SERVICE_URL=https://isl-staging.onrender.com

# ISL API Key - Required for authenticated ISL requests (server-side only)
# Injected by proxy as Authorization Bearer header
# ISL_API_KEY=your_isl_api_key_here

# PLoT Engine (already configured via PLOT_API_URL in .env.local)
# PLOT_API_URL=https://plot-lite-service.onrender.com

# S8/S9: Docked canvas layouts, command palette, diagnostics, degraded banner (ON by default)
# These defaults are also enforced in src/flags.ts via defaultValue, and can be
# overridden per-browser using localStorage['feature.*'] for tests/dev.
# localStorage overrides always win over env/defaults:
#   localStorage['feature.X'] === '0' or 'false' → OFF
#   localStorage['feature.X'] === '1'           → ON
VITE_FEATURE_INPUTS_OUTPUTS=1
VITE_FEATURE_COMMAND_PALETTE=1
VITE_FEATURE_DIAGNOSTICS=1
VITE_FEATURE_DEGRADED_BANNER=1

# Brief 5.7: EdgeV2 dual belief model and functional forms (OFF by default)
# When enabled, edges use beliefExists + beliefStrength instead of single belief
# and support noisy_or and logistic functional forms
# VITE_FEATURE_EDGE_V2=1

# Brief E: New results panel capabilities (ON for staging)
# Goal Probabilities: Shows per-option goal probability from PLoT
# ISL Synthesis: Shows AI-generated narratives explaining the decision
VITE_FEATURE_GOAL_PROBABILITIES=1
VITE_FEATURE_ISL_SYNTHESIS=1

# Brief v2.2: Decision Model Schema v2.2 support (OFF by default)
# When enabled:
# - UI requests ?schema=v2 from CEE
# - Handles observed_state on factor nodes
# - Handles effect_direction + strength_std on edges
# - ISL adapter uses signed strength.mean
# VITE_FEATURE_SCHEMA_V2=1

# Phase 1B: PLoT Enrichment Routing Consolidation (OFF by default)
# When enabled, UI consumes robustness/sensitivity data from PLoT's enrichment
# response instead of calling ISL directly. This eliminates the dual-pipeline
# problem where PLoT and ISL produce inconsistent results due to different RNGs.
# Graceful degradation: if enrichment is unavailable, falls back to direct ISL.
# Enable in staging first, monitor PostHog/Sentry before production rollout.
# VITE_USE_PLOT_ENRICHMENT=1

# Phase 2A/2B: Model Card Lite, Pre-analysis enrichment, Causal claims (OFF by default)
# Model Card Lite: trust card in Model tab (graph hash, seed, confidence, adjustments)
# Pre-analysis enriched: evidence gaps, model notes, post-run repairs in pre-analysis panel
# Causal claims: "Scientific basis" section in edge inspector
# VITE_FEATURE_MODEL_CARD_LITE=1
# VITE_FEATURE_PRE_ANALYSIS_ENRICHED=1
# VITE_FEATURE_CAUSAL_CLAIMS=1

# Phase 3A: Graph badges, node inspector enrichment, cross-surface highlighting (OFF by default)
# Graph badges: "?" evidence gap badge on factor nodes with no observed data
# Node intelligence: connectivity + driver status section in node inspector
# Cross highlight: bidirectional hover sync between canvas nodes and panel items
# VITE_FEATURE_GRAPH_BADGES=1
# VITE_FEATURE_NODE_INTELLIGENCE=1
# VITE_FEATURE_CROSS_HIGHLIGHT=1

# Orchestrator streaming: SSE progressive rendering of turn responses
# When ON, POST /orchestrate/v1/turn/stream replaces the synchronous /turn endpoint.
# Text deltas render incrementally; stores commit only on turn_complete.
# VITE_FEATURE_ORCHESTRATOR_STREAMING=1

# Debug Bundle v2.0: CEE diagnostic trace capture
# When ON, debug bundle includes _diagnostic_trace sections (LLM calls, provider resolution, etc.)
# Default: ON in development/staging, OFF in production
# VITE_DEBUG_BUNDLE_V2=true
# Override streaming endpoint (default: derives from VITE_ORCHESTRATOR_BASE + /stream suffix)
# VITE_ORCHESTRATOR_STREAM_BASE=
