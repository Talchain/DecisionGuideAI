# J1 stack: the UI's build-time flags, read from the deployed staging bundle (410fa444, deploy 6ac3601950a5d80008d0b85a), 5 Oct 2026.
# Vite inlines these at build. Endpoints and the Supabase key are set by the workflow. VITE_SENTRY_DSN is deliberately absent.
VITE_ENABLE_DEV_ROUTES=1
VITE_ENABLE_LEGACY_DIRECT_RUN=false
VITE_ENABLE_ORCHESTRATOR_V2=true
VITE_FEATURE_AI_PANEL_V2=true
VITE_FEATURE_BIL=true
VITE_FEATURE_COMPARE_TAB=1
VITE_FEATURE_CROSS_HIGHLIGHT=true
VITE_FEATURE_DECISION_OVERVIEW=1
VITE_FEATURE_DETERMINISTIC_CEE=1
VITE_FEATURE_GOAL_PROBABILITIES=1
VITE_FEATURE_GRAPH_BADGES=true
VITE_FEATURE_GRAPH_LENS=true
VITE_FEATURE_HERO_FIXTURE_GALLERY=1
VITE_FEATURE_ISL_SYNTHESIS=1
VITE_FEATURE_ORCHESTRATOR_RENDERING_V2=1
VITE_FEATURE_ORCHESTRATOR_STREAMING=false
VITE_FEATURE_PLOT_USES_PLC_CANVAS=1
VITE_FEATURE_PRE_ANALYSIS_ENRICHED=true
VITE_FEATURE_PRE_ANALYSIS_V3=1
VITE_FEATURE_SANDBOX_DECISION_CTA=1
VITE_FEATURE_SANDBOX_MAPPING=1
VITE_FEATURE_SANDBOX_PROJECTIONS=1
VITE_FEATURE_SANDBOX_REALTIME=1
VITE_FEATURE_SANDBOX_STRATEGY_BRIDGE=1
VITE_FEATURE_SANDBOX_TRIGGERS_BASIC=1
VITE_FEATURE_SANDBOX_VOTING=1
VITE_FEATURE_SCENARIO_SANDBOX=1
VITE_FEATURE_SCHEMA_V2=1
VITE_FEATURE_SSE=1
VITE_FEATURE_STRENGTHEN_PANEL=1
VITE_FEATURE_WHITEBOARD=1
VITE_USE_PLOT_ENRICHMENT=1
VITE_V5_CANONICAL_ANALYSIS=true
# from netlify.toml [build.environment] + [context.staging.environment]
VITE_APP_ENV=staging
VITE_AUTH_MODE=guest
VITE_COPILOT_ENABLED=true
VITE_DISABLE_OPENAI=1
VITE_EDGE_GATEWAY_URL=/engine
VITE_FORCE_ENGINE=1
VITE_PLC_LAB=1
VITE_POC_ONLY=0
VITE_STUB_SUPABASE=0
