# J1 stack: isl flags mirrored from the Render staging service, 5 Oct 2026 10:3xZ (names + non-secret values only).
# Endpoints, credentials, NODE_ENV and origins are set by the workflow, never here. Re-mirror when staging's flags change.
ENABLE_IDENTIFIABILITY_ANALYSIS=true
ENABLE_OUTCOME_LOGGING=true
ENABLE_PARETO_FRONTIER=true
ENABLE_ROBUSTNESS_SUITE=true
ENVIRONMENT=staging
LOG_LEVEL=INFO
