+++ b/src/orchestrator-v5/agent-lane/__tests__/answer-shape-sidecar.test.ts
@@ -0,0 +1,203 @@
+/**
+ * ⭐ AN AGENT REPLY CARRIES ITS OWN CONCISE VIEW — `_answer_shape` read back
+ * from the final text, never invented.
+ *
+ * Measured at CEE staging 57f903c on the real OpenAI route: every Agent reply
+ * already had the shape in markdown (a one-sentence conclusion, a `- ` list, a
+ * closing paragraph) and NONE carried `_answer_shape`, so the UI could only
+ * render it as a wall of text. The inputs below are those replies, byte for
+ * byte (`fixtures/served-agent-reply-texts-57f903c.json`).
+ *
+ * Both directions are pinned: the served replies that have the shape get it,
+ * and every reply that does not — a two-sentence opener, a bare receipt, the
+ * route's own fallback copy, empty text — gets NOTHING.
+ */
+import { readFileSync } from 'node:fs';
+import { describe, it, expect } from 'vitest';
+import { answerShapeSidecarFor, deriveAgentAnswerShape } from '../answer-shape-sidecar.js';
+import { AnswerShapeSchema } from '../../routing/answer-shape.js';
+
+const SERVED = JSON.parse(
+  readFileSync(new URL('./fixtures/served-agent-reply-texts-57f903c.json', import.meta.url), 'utf8'),
+) as { replies: Record<string, { assistant_text: string }> };
+const served = (name: string): string => {
+  const reply = SERVED.replies[name];
+  if (reply === undefined) throw new Error(`fixture has no reply named ${name}`);
+  return reply.assistant_text;
+};
+
+/** The UI's own acceptance rule (DecisionGuideAI `answerShape.ts` parseAnswerShape), restated as assertions. */
+function expectUiRenders(shape: ReturnType<typeof deriveAgentAnswerShape>): void {
+  expect(shape).not.toBeNull();
+  expect(shape!.headline.trim().length, 'the UI needs a non-blank headline').toBeGreaterThan(0);
+  expect(shape!.detail.trim().length, 'the UI needs a non-blank detail').toBeGreaterThan(0);
+  expect(shape!.bullets.length, 'at most three bullets').toBeLessThanOrEqual(3);
+  for (const b of shape!.bullets) expect(b.trim().length).toBeGreaterThan(0);
+  expect(AnswerShapeSchema.safeParse(shape).success, 'and the conventional lane’s own contract').toBe(true);
+}
+
+describe('served Agent replies (CEE 57f903c) that have the shape get the sidecar', () => {
+  it('pricing, explicit Run: one-sentence opener, the three bullets verbatim, the whole reply as detail', () => {
+    const text = served('pricing-run-complete.explicit-run');
+    const shape = deriveAgentAnswerShape(text);
+    expectUiRenders(shape);
+    // The bold covers only the opening clause, not the whole sentence, so it
+    // is kept exactly as written (the UI renders `**` as <strong>).
+    expect(shape!.headline).toBe(
+      '**This run does not establish whether you should raise Pro to £59**, because it could not test the stated churn limit and did not convert the £20k MRR threshold into the analysis’s outcome frame.',
+    );
+    expect(shape!.bullets).toEqual([
+      'On the model’s **MRR-only, normalised outcome scale**, the £59-at-release path was most often highest in the simulated comparison (**83.28%** of runs), versus **15.39%** for keeping £49 and **1.33%** for phasing. Those are comparative model results, not probabilities of achieving £20k MRR.',
+      'The decisive caveat is that **“monthly churn rate < 4%” was unscored**: the model treats churn as calculated from other factors, and the constraint’s frame was unspecified. So this result does not show whether £59 keeps churn below 4%.',
+      'The comparison also rests on adopted starting assumptions, notably **3% monthly churn**, **250 Pro subscribers**, and **£49/month MRR per Pro subscriber**. The model flags churn, subscriber base, and MRR per subscriber as its strongest structural drivers.',
+    ]);
+    expect(shape!.detail, 'nothing is lost: detail IS the reply').toBe(text);
+  });
+
+  it('hiring, explicit Run (blocked): one-sentence opener with inner bold kept, the three bullets under the lead-in', () => {
+    const text = served('hiring-run-blocked.explicit-run');
+    const shape = deriveAgentAnswerShape(text);
+    expectUiRenders(shape);
+    expect(shape!.headline).toBe(
+      'The comparison cannot run yet because **Continue Current Staffing** has no stated effect on any factor, so it has no connection to the productivity goal.',
+    );
+    expect(shape!.bullets).toEqual([
+      'Tech Lead sets Tech-lead capacity to **8 capacity points (0–10)**.',
+      'Two Developers sets Developer capacity to **12 capacity points (0–20)**.',
+      'One Developer sets Developer capacity to **10 capacity points (0–20)**.',
+    ]);
+    expect(shape!.detail).toBe(text);
+  });
+
+  it('hiring, construction: one-sentence opener → shaped; bullets are the FIRST list only (the assumption lists stay in detail)', () => {
+    const text = served('hiring-run-blocked.construction');
+    const shape = deriveAgentAnswerShape(text);
+    expectUiRenders(shape);
+    expect(shape!.headline).toBe(
+      'I’ve set up a comparison model, but it cannot yet tell us which hiring path leads under your circumstances.',
+    );
+    expect(shape!.bullets).toEqual([
+      '**Hire a Tech Lead**',
+      '**Hire Two Developers**',
+      'Also, for context: **Hire One Developer** and **Continue Current Staffing**',
+    ]);
+    expect(shape!.detail).toBe(text);
+    expect(shape!.detail).toContain('Tech-lead capacity: **4 capacity points (0–10)**');
+  });
+});
+
+describe('served Agent replies without the shape get NOTHING', () => {
+  it.each([
+    ['pricing-run-complete.construction', 'a two-sentence opener'],
+    ['pricing-run-complete.approve', 'a multi-sentence disclosure paragraph'],
+    ['hiring-run-blocked.approve', 'a two-sentence receipt'],
+  ])('%s (%s) → no sidecar', (name) => {
+    expect(deriveAgentAnswerShape(served(name))).toBeNull();
+    expect(answerShapeSidecarFor(served(name)), 'the KEY is absent, not an empty object').toEqual({});
+    expect('_answer_shape' in answerShapeSidecarFor(served(name))).toBe(false);
+  });
+});
+
+describe('rules — each limb, both directions', () => {
+  it('no bullets anywhere: still shaped when the opener is one sentence and more follows', () => {
+    const text = 'The model cannot compare these options yet.\n\nNeither option changes any factor, so the analysis has nothing to separate them on.';
+    const shape = deriveAgentAnswerShape(text);
+    expectUiRenders(shape);
+    expect(shape!.headline).toBe('The model cannot compare these options yet.');
+    expect(shape!.bullets).toEqual([]);
+    expect(shape!.detail).toBe(text);
+  });
+
+  it('a multi-sentence opener is declined, even with a list after it', () => {
+    expect(deriveAgentAnswerShape('The run finished. The price rise leads.\n\n- a point\n- another')).toBeNull();
+  });
+
+  it('a second sentence hidden behind bold markers is still a second sentence', () => {
+    // The shared detector alone reads both of these as ONE sentence, because
+    // `**` sits between the full stop and the space.
+    expect(deriveAgentAnswerShape('**The run finished.** The price rise leads.\n\nMore follows.')).toBeNull();
+    expect(deriveAgentAnswerShape('The run finished. **The price rise leads.**\n\nMore follows.')).toBeNull();
+  });
+
+  it.each([
+    ['empty', ''],
+    ['whitespace only', '  \n\n \t'],
+    ['not a string', undefined],
+    ['null', null],
+  ])('%s → null', (_label, input) => {
+    expect(deriveAgentAnswerShape(input)).toBeNull();
+    expect(answerShapeSidecarFor(input)).toEqual({});
+  });
+
+  it('a reply that is ONLY its headline is declined — there is nothing to put behind "Show more"', () => {
+    expect(deriveAgentAnswerShape('The analysis ran on the current model.')).toBeNull();
+    expect(deriveAgentAnswerShape('The analysis ran on the current model.\n\n  \n')).toBeNull();
+  });
+
+  it('more than three bullets: the first three are shown and detail keeps all of them', () => {
+    const text = 'Five things changed.\n\n- one\n- two\n- three\n- four\n- five\n\nThat is all.';
+    const shape = deriveAgentAnswerShape(text);
+    expectUiRenders(shape);
+    expect(shape!.bullets).toEqual(['one', 'two', 'three']);
+    expect(shape!.detail).toBe(text);
+    expect(shape!.detail).toContain('- four\n- five');
+  });
+
+  it('only the FIRST list is read; a later list after a paragraph is not', () => {
+    const shape = deriveAgentAnswerShape('Two lists follow.\n\n- a\n- b\n\nA paragraph between.\n\n- c\n- d');
+    expect(shape!.bullets).toEqual(['a', 'b']);
+  });
+
+  it('indented sub-items and continuation lines are not top-level bullets', () => {
+    const shape = deriveAgentAnswerShape('Nested list.\n\n- a\n  - a.1\n  continued\n- b\n\nEnd.');
+    expect(shape!.bullets).toEqual(['a', 'b']);
+  });
+
+  it('`* ` items count as bullets; loose lists (blank lines between items) stay one list', () => {
+    const shape = deriveAgentAnswerShape('Star list.\n\n* one\n\n* two\n\nClosing words.');
+    expect(shape!.bullets).toEqual(['one', 'two']);
+  });
+
+  it('a list directly under the opener (no blank line) is read', () => {
+    const shape = deriveAgentAnswerShape('Here are the options:\n- keep the price\n- raise it');
+    expectUiRenders(shape);
+    expect(shape!.headline).toBe('Here are the options:');
+    expect(shape!.bullets).toEqual(['keep the price', 'raise it']);
+  });
+
+  it('a WHOLLY bold sentence loses only its wrapping `**`; partial bold is kept verbatim', () => {
+    expect(deriveAgentAnswerShape('**Raise the price at release.**\n\nMore follows.')!.headline).toBe('Raise the price at release.');
+    expect(deriveAgentAnswerShape('**Raise the price at release**.\n\nMore follows.')!.headline).toBe('Raise the price at release.');
+    expect(deriveAgentAnswerShape('**Raise** the price at release.\n\nMore follows.')!.headline).toBe('**Raise** the price at release.');
+    // Two bold spans are not one wrapping span.
+    expect(deriveAgentAnswerShape('**Raise** it and **keep** it.\n\nMore follows.')!.headline).toBe('**Raise** it and **keep** it.');
+  });
+
+  it.each([
+    ['a heading', '## Result\n\nThe run finished.'],
+    ['a list', '- first point\n- second point\n\nClosing.'],
+    ['a numbered list', '1. first\n2. second\n\nClosing.'],
+    ['a quote', '> quoted\n\nClosing.'],
+    ['a table', '| a | b |\n|---|---|\n\nClosing.'],
+    ['a code fence', '```\ncode\n```\n\nClosing.'],
+  ])('a reply that opens with %s is declined', (_label, text) => {
+    expect(deriveAgentAnswerShape(text)).toBeNull();
+  });
+
+  it('an opening paragraph that wraps onto a second line is declined (re-joining it would be rewriting)', () => {
+    expect(deriveAgentAnswerShape('This is one sentence\nthat wraps onto a second line.\n\n- a')).toBeNull();
+  });
+
+  it('CRLF replies are read the same way, and detail keeps the original bytes', () => {
+    const text = 'Line endings differ.\r\n\r\n- a\r\n- b\r\n\r\nEnd.';
+    const shape = deriveAgentAnswerShape(text);
+    expect(shape!.headline).toBe('Line endings differ.');
+    expect(shape!.bullets).toEqual(['a', 'b']);
+    expect(shape!.detail).toBe(text);
+  });
+
+  it('is pure: the same text always yields the same shape', () => {
+    const text = served('pricing-run-complete.explicit-run');
+    expect(deriveAgentAnswerShape(text)).toEqual(deriveAgentAnswerShape(text));
+  });
+});
