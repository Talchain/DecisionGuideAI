+++ b/src/orchestrator-v5/agent-lane/answer-shape-sidecar.ts
@@ -0,0 +1,113 @@
+/**
+ * ⭐ THE AGENT LANE'S `_answer_shape` SIDECAR — derived from the FINAL reply
+ * text, deterministically, with no model call.
+ *
+ * The UI renders `_answer_shape` ({ headline, bullets, detail }) as a concise
+ * headline + at most three bullets, with `detail` behind "Show more"
+ * (DecisionGuideAI `src/canvas/conversation/answerShape.ts`). The conventional
+ * lane attaches it in `route-v2.ts`'s `sendFinalised200`; `/agent/v1/turn`
+ * never goes through that egress, so an Agent reply arrived with NO sidecar —
+ * measured on the real OpenAI route captures at CEE staging `57f903c`
+ * (`__tests__/fixtures/served-agent-reply-texts-57f903c.json`).
+ *
+ * The Agent already writes the shape as markdown: a first-paragraph
+ * conclusion, then a `- ` list, then a closing paragraph. This reads that
+ * shape back; it never writes one.
+ *
+ * RULES — fail closed: any doubt returns `null` and the reply ships as free
+ * text, exactly as before. No text is ever invented, reworded or reordered.
+ *   - headline: the first paragraph, and only when it is ONE line and ONE
+ *     sentence (`isSingleSentence` — the conventional lane's own detector, so
+ *     the two lanes cannot disagree on what a sentence is). Kept verbatim; the
+ *     one edit allowed is removing a `**…**` pair that wraps the WHOLE
+ *     sentence. Partial bold stays exactly as written.
+ *   - bullets: the top-level `- ` / `* ` / `• ` items of the FIRST list after
+ *     the headline, marker removed, inner markdown kept, at most
+ *     `ANSWER_SHAPE_MAX_BULLETS`. Indented lines stay in `detail` only.
+ *   - detail: the WHOLE reply, byte for byte. Nothing is lost when the UI
+ *     shows the structured view in place of the free text.
+ *   - null when the reply is only its headline (nothing to put behind
+ *     "Show more"), when it opens with a list, heading, quote, table or code
+ *     block, or when the result fails `AnswerShapeSchema` (the same contract
+ *     the conventional lane validates against).
+ *
+ * ⚠ THIS SIDECAR DOES NOT SATISFY THE CONVENTIONAL LANE'S TIE, AND SAYS SO.
+ * There `assistant_text === deriveAnswerTextFromShape(shape)` because that
+ * lane REWRITES `assistant_text` from the shape. Here `assistant_text` is left
+ * exactly as it was and `detail` carries all of it, so the headline and
+ * bullets are copies of text `detail` already holds. The sidecar is therefore
+ * derived from the text ACTUALLY SENT, as the last step before sending, so no
+ * later rewrite can leave it describing text the user never received.
+ */
+
+import {
+  ANSWER_SHAPE_MAX_BULLETS,
+  AnswerShapeSchema,
+  isSingleSentence,
+  type AnswerShape,
+} from '../routing/answer-shape.js';
+
+/** A top-level list item: marker in column 0, whitespace, then content. */
+const TOP_LEVEL_BULLET = /^[-*•][ \t]+(\S.*)$/;
+/** An opening line that is structure, not a sentence: heading, list, quote, table, code fence, rule. */
+const NOT_A_HEADLINE = /^(?:#{1,6}\s|[-*+•]\s|\d+[.)]\s|>|\||```|~~~|---|___|\*\*\*$)/;
+/** `**Whole sentence.**` or `**Whole sentence**.` — one bold span covering the entire line. */
+const WHOLLY_BOLD = /^\*\*((?:(?!\*\*).)+)\*\*([.!?]?)$/;
+
+const isBlank = (line: string): boolean => line.trim().length === 0;
+
+/**
+ * The sentence test runs on the headline with emphasis markers removed. The
+ * shared detector needs whitespace straight after the terminator, so
+ * `**One.** Two.` and `One. **Two.**` would each read as ONE sentence with the
+ * markers in place — and Agent replies are markdown. Used only to decide; the
+ * headline itself keeps its markers.
+ */
+const withoutEmphasis = (text: string): string => text.replace(/\*+|_{2}|`/g, '');
+
+function headlineFrom(line: string): string {
+  const bold = WHOLLY_BOLD.exec(line);
+  return bold === null ? line : `${bold[1]}${bold[2]}`;
+}
+
+export function deriveAgentAnswerShape(finalText: unknown): AnswerShape | null {
+  if (typeof finalText !== 'string' || finalText.trim().length === 0) return null;
+
+  const lines = finalText.trim().split(/\r?\n/);
+  const opener = lines[0]!.trim();
+  if (NOT_A_HEADLINE.test(opener)) return null;
+  // The first paragraph must be the opener alone. A paragraph that wraps onto
+  // a second line would have to be re-joined to become a headline — that is
+  // rewriting, so it is declined. A list may follow the opener directly.
+  const second = lines[1];
+  if (second !== undefined && !isBlank(second) && !TOP_LEVEL_BULLET.test(second)) return null;
+  const headline = headlineFrom(opener);
+  if (!isSingleSentence(headline) || !isSingleSentence(withoutEmphasis(headline))) return null;
+  // Only the headline: there is nothing to disclose, and a "Show more" that
+  // reveals the same sentence again is worse than the plain reply.
+  if (lines.slice(1).every(isBlank)) return null;
+
+  const bullets: string[] = [];
+  let inList = false;
+  for (const line of lines.slice(1)) {
+    const item = TOP_LEVEL_BULLET.exec(line);
+    if (item !== null) {
+      inList = true;
+      if (bullets.length < ANSWER_SHAPE_MAX_BULLETS) bullets.push(item[1]!.trimEnd());
+      continue;
+    }
+    // Blank lines and indented continuation / sub-items belong to the list.
+    if (isBlank(line) || /^\s/.test(line)) continue;
+    // The first non-list line after the list ends it: only the FIRST list counts.
+    if (inList) break;
+  }
+
+  const parsed = AnswerShapeSchema.safeParse({ headline, bullets, detail: finalText });
+  return parsed.success ? parsed.data : null;
+}
+
+/** Spread into the response body: `{ _answer_shape }` when the text has the shape, else nothing at all. */
+export function answerShapeSidecarFor(finalText: unknown): { _answer_shape?: AnswerShape } {
+  const shape = deriveAgentAnswerShape(finalText);
+  return shape === null ? {} : { _answer_shape: shape };
+}
