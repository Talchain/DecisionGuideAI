+++ b/src/orchestrator-v5/agent-lane/__tests__/agent-turn-answer-shape.test.ts
@@ -0,0 +1,135 @@
+/**
+ * ⭐ `_answer_shape` REACHES THE HTTP BODY OF `/agent/v1/turn` — the route-level
+ * half of `answer-shape-sidecar.test.ts`.
+ *
+ * The provider is a scripted `fetch` stub: no model is called. Its reply is a
+ * SERVED Agent reply (CEE 57f903c, `fixtures/served-agent-reply-texts-57f903c.json`),
+ * so the text goes through the route's real composition (write-outcome
+ * narration, disclosures, proposal-id scrub, finaliser) before the sidecar is
+ * read back from what is actually sent.
+ *
+ * Pinned: the sidecar survives serialisation; `assistant_text` is unchanged;
+ * `detail` is exactly the sent text; a reply without the shape carries NO key
+ * and otherwise the same body; a lost-response replay carries the identical
+ * sidecar; the route's own fallback copy is never shaped.
+ */
+import { readFileSync } from 'node:fs';
+import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
+import Fastify, { type FastifyInstance } from 'fastify';
+
+const SERVED = JSON.parse(
+  readFileSync(new URL('./fixtures/served-agent-reply-texts-57f903c.json', import.meta.url), 'utf8'),
+) as { replies: Record<string, { assistant_text: string }> };
+const PRICING_RUN = SERVED.replies['pricing-run-complete.explicit-run']!.assistant_text;
+const PRICING_CONSTRUCTION = SERVED.replies['pricing-run-complete.construction']!.assistant_text;
+
+type Row = { id: string; turn_id: string; request_hash: string; assistant_message: string | null; user_message: string | null };
+const rows = new Map<string, Row>();
+const store = {
+  ensureScenarioExists: vi.fn(async () => ({ user_id: null })),
+  readCommittedTurn: vi.fn(async (_sid: string, turnId: string) => rows.get(turnId) ?? null),
+  append: vi.fn(async (w: { turn_id: string; request_hash: string; assistantMessage?: string; userMessage?: string }) => {
+    const prior = rows.get(w.turn_id);
+    if (prior !== undefined) return prior.request_hash === w.request_hash ? { id: prior.id, replayedPriorTurn: true as const } : { id: prior.id, priorTurnConflict: true as const };
+    const row: Row = { id: `row-${rows.size + 1}`, turn_id: w.turn_id, request_hash: w.request_hash, assistant_message: w.assistantMessage ?? null, user_message: w.userMessage ?? null };
+    rows.set(w.turn_id, row);
+    return { id: row.id };
+  }),
+};
+vi.mock('../../session/index.js', () => ({ getSessionStore: () => store }));
+vi.mock('../../../orchestrator/user-identity.js', async (importOriginal) => {
+  const actual = await importOriginal<Record<string, unknown>>();
+  return { ...actual, resolveUserIdentity: async () => ({ mode: 'off' }) };
+});
+
+/** The scripted provider: answers with `nextReply`, and records every URL it was asked for. */
+let nextReply = PRICING_RUN;
+const provider: { urls: string[] } = { urls: [] };
+const fakeFetch = vi.fn(async (url: unknown) => {
+  provider.urls.push(String(url));
+  return new Response(JSON.stringify({ output: [{ type: 'message', content: [{ type: 'output_text', text: nextReply }] }] }), { status: 200 });
+});
+
+const SID = '7a2b3c4d-5e6f-4a70-8b91-a2b3c4d5e6f7';
+const T1 = '3e4f5a6b-7c8d-4e9f-8a0b-1c2d3e4f5a6b';
+
+type Body = Record<string, unknown> & { assistant_text: string; _answer_shape?: { headline: string; bullets: string[]; detail: string } };
+
+describe('/agent/v1/turn carries `_answer_shape` on the wire', () => {
+  let app: FastifyInstance;
+  beforeEach(async () => {
+    rows.clear(); provider.urls = []; nextReply = PRICING_RUN;
+    store.append.mockClear(); store.readCommittedTurn.mockClear();
+    vi.stubGlobal('fetch', fakeFetch);
+    vi.resetModules();
+    process.env.AGENT_LANE_ENABLED = 'true';
+    process.env.AGENT_LANE_PREVIEW = 'false';
+    const { agentV1TurnRoute } = await import('../../../routes/agent-v1-turn.js');
+    app = Fastify({ logger: false });
+    app.post('/assist/v1/scenarios/:id/graph', async () => ({ graph: { nodes: [], edges: [] }, graph_hash: 'h1' }));
+    await app.register(agentV1TurnRoute);
+    await app.ready();
+  }, 60_000);
+  afterEach(async () => { await app.close(); vi.unstubAllGlobals(); delete process.env.AGENT_LANE_ENABLED; delete process.env.AGENT_LANE_PREVIEW; });
+
+  const say = (message: string, turnId?: string) =>
+    app.inject({ method: 'POST', url: '/agent/v1/turn', payload: { kind: 'message', scenario_id: SID, message, ...(turnId ? { turn_id: turnId } : {}) } });
+
+  it('a served reply with the shape → `_answer_shape` in the HTTP body, assistant_text untouched, detail === assistant_text', async () => {
+    const r = await say('What did the run show?');
+    expect(r.statusCode).toBe(200);
+    // `r.json()` parses the SERIALISED payload: the key survived to the wire.
+    const body = r.json() as Body;
+    expect(body.assistant_text, 'the reply text is exactly what the model said — nothing rewritten').toBe(PRICING_RUN);
+    expect(body._answer_shape).toBeDefined();
+    expect(body._answer_shape!.headline).toBe(
+      '**This run does not establish whether you should raise Pro to £59**, because it could not test the stated churn limit and did not convert the £20k MRR threshold into the analysis’s outcome frame.',
+    );
+    expect(body._answer_shape!.bullets).toHaveLength(3);
+    expect(body._answer_shape!.detail, 'the whole sent text, byte for byte').toBe(body.assistant_text);
+    expect(provider.urls, 'the only "provider" was the stub').toEqual(['https://api.openai.com/v1/responses']);
+  });
+
+  it('a served reply WITHOUT the shape → no `_answer_shape` key, and otherwise the same body keys', async () => {
+    const shaped = (await say('What did the run show?')).json() as Body;
+    nextReply = PRICING_CONSTRUCTION;
+    const r = await say('Set up the pricing model.');
+    expect(r.statusCode).toBe(200);
+    const plain = r.json() as Body;
+    // The route's own write-outcome narration edits this text (no tool saved
+    // anything here), so only its two-sentence opener is asserted.
+    expect(plain.assistant_text.startsWith(PRICING_CONSTRUCTION.split('\n')[0]!)).toBe(true);
+    expect('_answer_shape' in plain, 'absent, not null or {}').toBe(false);
+    expect(Object.keys(plain).sort(), 'the sidecar is the ONLY key this adds').toEqual(
+      Object.keys(shaped).filter((k) => k !== '_answer_shape').sort(),
+    );
+  });
+
+  it('a lost-response replay (same turn_id) carries the identical sidecar, with no second model call', async () => {
+    const first = (await say('What did the run show?', T1)).json() as Body;
+    expect(first._answer_shape).toBeDefined();
+    const retry = await say('What did the run show?', T1);
+    expect(retry.statusCode).toBe(200);
+    const again = retry.json() as Body & { _agent?: { replayed?: boolean } };
+    expect(again._agent?.replayed).toBe(true);
+    expect(provider.urls, 'the replay did not call the model').toHaveLength(1);
+    expect(again.assistant_text).toBe(first.assistant_text);
+    expect(again._answer_shape).toEqual(first._answer_shape);
+  });
+
+  it('the route’s own fallback copy is never shaped', async () => {
+    const { interpretationUnavailableText } = await import('../../../routes/agent-v1-turn.js');
+    const { deriveAgentAnswerShape } = await import('../answer-shape-sidecar.js');
+    for (const copy of [
+      interpretationUnavailableText({ ok: true, ran: true }),
+      interpretationUnavailableText({ ok: true, what_is_missing: 'No option has a path to the goal.' }),
+      interpretationUnavailableText({ ok: true, refusal: 'model_too_large' }),
+      // The hop-limit copy, as the route writes it.
+      'I was not able to finish that within this turn. Ask me again and I will continue.',
+      // The read-only preview refusal.
+      'This is a read-only preview, so I can’t change the model from the board. Tell me what you want to change and I’ll talk it through.',
+    ]) {
+      expect(deriveAgentAnswerShape(copy), copy).toBeNull();
+    }
+  });
+});
diff --git a/src/orchestrator-v5/agent-lane/__tests__/answer-shape-sidecar.test.ts b/src/orchestrator-v5/agent-lane/__tests__/answer-shape-sidecar.test.ts
