{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["vite/client", "react", "react-dom"]
  },
  "include": [
    "src/flags.ts",
    "src/lib/ci-shims.d.ts",
    "src/lib/sseClient.ts",
    "src/lib/markdown.ts",
    "src/lib/history.ts",
    "src/lib/session.ts",
    "src/lib/export.ts",
    "src/lib/runReport.ts",
    "src/lib/telemetry.ts",
    "src/components/SandboxStreamPanel.tsx",
    "src/components/RunHistoryDrawer.tsx",
    "src/components/RunReportDrawer.tsx",
    "src/v5/**/*.ts",
    "src/v5/**/*.tsx",

    // pre-analysis-power-v2: widen the CI gate to cover the leaf util
    // files where recent extractions live. Adding broader source globs
    // here pulls transitive imports (adapters, store, etc.) into the
    // typecheck and surfaces ~1000 pre-existing errors unrelated to this
    // work — that needs its own brief. These three utils are leaf-ish
    // (only import @xyflow/react types) so they typecheck cleanly and
    // guard the predicates / progress-derivation against
    // undefined-symbol regressions like the earlier `REVIEWED_SOURCES`
    // reference.
    "src/canvas/components/pre-analysis/utils/isReviewedByUser.ts",
    "src/canvas/components/pre-analysis/utils/isAiSource.ts",
    "src/canvas/components/pre-analysis/utils/buildPriorityProgress.ts",

    // failure-recovery (A1 brief item 2): the CEE failure-recovery reader is a
    // zero-import pure leaf (operates on `unknown`), so it typechecks cleanly
    // under the narrow gate without dragging in the conversation graph.
    "src/canvas/conversation/ceeRecovery.ts"
  ],
  "exclude": [
    "src/components/teams/**",
    "src/components/ProsConsList/**",
    "src/contexts/**",
    "src/types/**",
    "src/lib/supabase.ts",
    "src/lib/api.ts",
    "e2e/**"
  ]
}
