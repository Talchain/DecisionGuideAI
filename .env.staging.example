# Staging environment overrides
# Copy to .env.staging.local and fill in values.
# .env.staging.local is gitignored — do NOT commit real values.

# V5 turn endpoint — routes browser requests through the CEE browser proxy
# instead of the Netlify Edge function (which times out at ~40s for draft graph calls).
# Set to the staging CEE service URL when BROWSER_PROXY_ENABLED=true on Render.
VITE_V5_ENDPOINT=https://cee-staging.onrender.com/proxy/v5/turn
